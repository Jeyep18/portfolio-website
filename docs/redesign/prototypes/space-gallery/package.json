{
  "name": "space-gallery-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8769 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "check": "tsc --noEmit",
    "check:build": "node scripts/check-build.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 8769 --strictPort"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
